# Security Guardrail Auditor — environment variables

# Database (default: SQLite file in project root)
DATABASE_URL=sqlite+aiosqlite:///./security_auditor.db

# Optional: OpenAI API key for AI-powered finding explanations
# If absent, rule-based findings are returned without AI summary
OPENAI_API_KEY=

# Max file size in MB (default: 20)
MAX_FILE_SIZE_MB=20
